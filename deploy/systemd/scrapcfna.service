[Unit]
Description=scrapcfna (gunicorn)
After=network.target

[Service]
Type=notify
User=scrapcfna
# El grupo www-data permite que nginx acceda al socket.
Group=www-data
WorkingDirectory=/opt/scrapcfna
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=/etc/scrapcfna.env
# Crea /run/scrapcfna (socket), /var/lib/scrapcfna (base SQLite) y /var/cache/scrapcfna (throttling).
RuntimeDirectory=scrapcfna
StateDirectory=scrapcfna
CacheDirectory=scrapcfna
ExecStart=/opt/scrapcfna/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/scrapcfna/gunicorn.sock \
    --umask 007 \
    --workers 3 \
    --timeout 60 \
    --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
KillMode=mixed

[Install]
WantedBy=multi-user.target
