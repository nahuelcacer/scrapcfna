[Unit]
Description=Scraping de noticias de cfna.org.ar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scrapcfna
WorkingDirectory=/opt/scrapcfna
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=/etc/scrapcfna.env
StateDirectory=scrapcfna
CacheDirectory=scrapcfna
ExecStart=/opt/scrapcfna/venv/bin/python manage.py scrapear_noticias --paginas 2 --origen cron
TimeoutStartSec=300
