# Copiar a `.env` para desarrollo, o a /etc/scrapcfna.env en producción (Debian).
# Nunca subir el archivo real al repositorio.

# --- Desarrollo ---
# DJANGO_DEBUG=1

# --- Producción (obligatorias) ---
# Generar con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.midominio.com

# --- Producción (opcionales) ---
# Base SQLite fuera del código; el usuario del servicio debe poder escribir en ese directorio.
DJANGO_DB_PATH=/var/lib/scrapcfna/db.sqlite3
# Destino de `collectstatic` (nginx sirve /static/ desde acá).
DJANGO_STATIC_ROOT=/var/www/scrapcfna/static
# Cache compartido entre workers de gunicorn (contadores del throttling).
DJANGO_CACHE_DIR=/var/cache/scrapcfna
# Redirigir http -> https y marcar cookies como secure. Poner 0 si servís solo por http (sin dominio/certificado). Default: 1.
# DJANGO_SSL_REDIRECT=1
# HSTS en segundos; activarlo (p. ej. 31536000) recién cuando https funcione bien. Default: 0.
# DJANGO_HSTS_SECONDS=0
# DJANGO_LOG_LEVEL=INFO
